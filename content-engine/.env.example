# Anthropic — required
ANTHROPIC_API_KEY=sk-ant-...

# Buffer — only needed if you pass --buffer flag
# Get your access token: https://buffer.com/developers/api/
# Get your LinkedIn profile ID by calling: GET https://api.bufferapp.com/1/profiles.json?access_token=YOUR_TOKEN
BUFFER_ACCESS_TOKEN=
BUFFER_LINKEDIN_PROFILE_ID=

# Ghost CMS — only needed if you pass --publish-ghost
# Admin API key: Ghost Admin → Settings → Integrations → Add custom integration
GHOST_ADMIN_URL=https://your-blog.ghost.io
GHOST_ADMIN_API_KEY=key_id:secret

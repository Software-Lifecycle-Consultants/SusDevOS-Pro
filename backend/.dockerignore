# Development artifacts
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Dev environment files
# NB: the old "*.env.*" glob did NOT match ".env.prod" (it needs a leading
# segment), so the production secrets file was being copied into the image by
# "COPY . .". ".env.*" matches it.
.env
.env.*
!.env.example
!.env.prod.example

# Tests (not needed in production image)
apps/*/tests/
conftest.py

# Docs and specs
*.md
docs/

# Git
.git/
.gitignore

# ─── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here-min-50-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.local

# ─── Database ──────────────────────────────────────────────────────────────────
DB_ENGINE=django.contrib.gis.db.backends.postgis
DB_NAME=susdevos
DB_USER=susdevos_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CACHE_LOCATION=redis://localhost:6379/3

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
# Signing key — use a different value from SECRET_KEY in production
JWT_SIGNING_KEY=your-jwt-signing-key-here

# ─── File Storage (S3 / MinIO) ─────────────────────────────────────────────────
USE_S3=False                              # Set True in production; False uses local media
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_STORAGE_BUCKET_NAME=susdevos-files
AWS_S3_REGION_NAME=ap-southeast-1
# For self-hosted MinIO — set endpoint_url; leave blank for AWS S3
AWS_S3_ENDPOINT_URL=http://localhost:9000
# Pre-signed URL expiry (seconds)
AWS_S3_PRESIGNED_URL_EXPIRY=3600

# Node identifier — used in S3 path convention /{node_id}/{entity_id}/...
SUSDEVOS_NODE_ID=node-1

# ─── Email (SMTP / SES) ────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production values (switch EMAIL_BACKEND to django.core.mail.backends.smtp.EmailBackend):
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=your-smtp-password
DEFAULT_FROM_EMAIL=SusDevOS <noreply@example.com>
FOUNDING_APPLICATION_EMAIL=hello@susdevos.com

# ─── SuperAdmin Bootstrap ──────────────────────────────────────────────────────
# Used by: python manage.py seed_superadmins
SUPERADMIN_1_EMAIL=superadmin1@example.com
SUPERADMIN_1_USERNAME=superadmin1
SUPERADMIN_1_PASSWORD=ChangeMe!12345
SUPERADMIN_2_EMAIL=superadmin2@example.com
SUPERADMIN_2_USERNAME=superadmin2
SUPERADMIN_2_PASSWORD=ChangeMe!67890

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_AUTHENTICATED=100/min
RATE_LIMIT_UNAUTHENTICATED=10/min
RATE_LIMIT_FOUNDING_APPLICATION=5/hour

# ─── GWP Default Dataset ───────────────────────────────────────────────────────
# ID of the GwpDatasets row to use by default for new emissions records
DEFAULT_GWP_DATASET_ID=1

# ─── Sentry (optional, production) ─────────────────────────────────────────────
SENTRY_DSN=

# ─── Public site ───────────────────────────────────────────────────────────────
SITE_NAME=SusDevOS
SITE_URL=http://localhost:5173

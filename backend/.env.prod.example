# Production environment — copy to backend/.env.prod and fill in real values.
# Never commit .env.prod to git.

# ─── Django ────────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=                          # min 50 random chars — python -c "import secrets; print(secrets.token_urlsafe(60))"
DEBUG=False
# Every entry here is load-bearing; Django rejects any Host not listed with a
# 400 DisallowedHost.
#   localhost/127.0.0.1 — the Docker healthcheck and the CI deploy gate request
#                         http://localhost:8000/health/ from inside the container.
#   api                 — Next.js server-side rendering calls the API over the
#                         compose network as http://api:8000 (NEXT_PUBLIC_API_URL),
#                         so Django sees "Host: api:8000". Without this the blog,
#                         sitemap and RSS routes fail with 400 while the browser-
#                         facing pages look fine, because those fetches happen in
#                         the Next container rather than the browser.
ALLOWED_HOSTS=susdevos.com,www.susdevos.com,api,localhost,127.0.0.1
SITE_NAME=SusDevOS
SITE_URL=https://susdevos.com
# Base URL of the Next.js frontend — used to build password-reset & onboarding
# links in emails. MUST be set or reset emails point to http://localhost:3000.
FRONTEND_URL=https://susdevos.com

# ─── Database ──────────────────────────────────────────────────────────────────
# Service name "db" resolves to the PostgreSQL container on the Docker network
DB_ENGINE=django.contrib.gis.db.backends.postgis
DB_NAME=susdevos
DB_USER=susdevos
DB_PASSWORD=                         # strong random password
DB_HOST=db
DB_PORT=5432

# ─── Redis ─────────────────────────────────────────────────────────────────────
# Service name "redis" resolves to the Redis container on the Docker network
REDIS_URL=redis://redis:6379/2
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CACHE_LOCATION=redis://redis:6379/3

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_SIGNING_KEY=                     # different from SECRET_KEY — python -c "import secrets; print(secrets.token_urlsafe(60))"

# ─── File Storage — Cloudflare R2 ─────────────────────────────────────────────
# Create a bucket at dash.cloudflare.com → R2 → Create bucket
# API tokens: R2 → Manage R2 API Tokens → Create Token (Object Read & Write)
USE_S3=True
AWS_ACCESS_KEY_ID=                   # R2 Access Key ID
AWS_SECRET_ACCESS_KEY=               # R2 Secret Access Key
AWS_STORAGE_BUCKET_NAME=susdevos-files
AWS_S3_REGION_NAME=auto
AWS_S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_S3_PRESIGNED_URL_EXPIRY=3600
SUSDEVOS_NODE_ID=node-1

# ─── Email — Postmark ──────────────────────────────────────────────────────────
# Sign up at postmarkapp.com → create a Server → copy the Server API Token
# Use the token as both EMAIL_HOST_USER and EMAIL_HOST_PASSWORD
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.postmarkapp.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=                     # Postmark Server API Token
EMAIL_HOST_PASSWORD=                 # Same Postmark Server API Token
DEFAULT_FROM_EMAIL=SusDevOS <noreply@susdevos.com>
FOUNDING_APPLICATION_EMAIL=hello@susdevos.com

# ─── SuperAdmin Bootstrap ──────────────────────────────────────────────────────
SUPERADMIN_1_EMAIL=superadmin1@susdevos.com
SUPERADMIN_1_USERNAME=superadmin1
SUPERADMIN_1_PASSWORD=               # strong password — change immediately after first login
SUPERADMIN_2_EMAIL=superadmin2@susdevos.com
SUPERADMIN_2_USERNAME=superadmin2
SUPERADMIN_2_PASSWORD=               # strong password — change immediately after first login

# ─── CORS / CSRF ───────────────────────────────────────────────────────────────
# Next.js runs on the same domain via Nginx reverse proxy — only susdevos.com needed
CORS_ALLOWED_ORIGINS=https://susdevos.com
# Trusted origins for CSRF (must include scheme). Required for cookie-based auth
# over HTTPS or Django rejects unsafe requests with 403 CSRF failures.
CSRF_TRUSTED_ORIGINS=https://susdevos.com

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_AUTHENTICATED=100/min
RATE_LIMIT_UNAUTHENTICATED=10/min
RATE_LIMIT_FOUNDING_APPLICATION=5/hour

# ─── GWP Default ───────────────────────────────────────────────────────────────
DEFAULT_GWP_DATASET_ID=1

# ─── Sentry (error tracking) ───────────────────────────────────────────────────
# Free tier at sentry.io — create a Django project and copy the DSN
SENTRY_DSN=

# ─── Optional API integrations ─────────────────────────────────────────────────
# Leave blank to disable — tasks will log a warning and skip
CLIMATIQ_API_KEY=
COMPANIES_HOUSE_API_KEY=
OPENCORPORATES_API_KEY=
IUCN_API_KEY=
VERRA_CSV_URL=
OPEN_EXCHANGE_RATES_API_KEY=

# ─── Data protection ───────────────────────────────────────────────────────────
BREACH_NOTIFICATION_EMAIL=security@susdevos.com
DPO_EMAIL=dpo@susdevos.com

# Per-capability feature gating. Default False: plans are sold on service and
# hosting tiers, not per feature. Set to True to re-enable PlanFeatures/402 gating.
FEATURE_GATES_ENABLED=False

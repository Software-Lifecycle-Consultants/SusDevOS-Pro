# Keeps frontend/public/ in git.
#
# frontend/Dockerfile does `COPY --from=builder /app/public ./public`, which fails the
# production image build outright if the directory does not exist:
#
#   target nextjs: failed to solve: failed to compute cache key:
#   failed to calculate checksum of ref ...: "/app/public": not found
#
# git does not track empty directories, so this placeholder is what makes it exist.
# Delete it once real static assets (favicon, og image, etc.) live here.
#
# Note: robots.txt and sitemap.xml are generated by src/app/robots.ts and
# src/app/sitemap.ts — do NOT add static versions here, they would shadow the routes.
